{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/lib/firebase/firebase.js",
    "src/app/layout.jsx",
    "src/components/landing/Hero.jsx",
    "tailwind.config.js",
    "src/components/admin/AdminTestimonials.jsx",
    "src/app/services/page.jsx",
    "src/app/page.jsx",
    "src/app/signup/page.jsx",
    "src/app/login/page.jsx",
    "src/app/contact/page.jsx",
    "src/components/admin/MarketingAdProjectForm.jsx"
  ],
  "exclude": ["node_modules"]
}
